<?xml version="1.0"?>
<!DOCTYPE package-info SYSTEM "https://www.elkarte.net/site/package-info">
<package-info xmlns="https://www.elkarte.net/site/package-info" xmlns:elk="https://www.elkarte.net/">
	<name>Bookmarks</name>
	<id>aaronvg:bookmarks</id>
	<type>addon</type>
	<version>2.0.0</version>

	<install for="2.0.0 Beta 1 - 2.0.99">
		<require-dir name="Bookmarks" destination="ADDONSDIR" />
		<require-dir name="Languages/Bookmarks" destination="LANGUAGEDIR" />

		<require-file name="theme/Bookmarks.template.php" destination="THEMEDIR" />

		<hook hook="integrate_general_mod_settings" file="ADDONSDIR/Bookmarks/BookmarksIntegrate.php" function="bmks_integrate_general_mod_settings" />
		<hook hook="integrate_load_permissions" file="ADDONSDIR/Bookmarks/BookmarksIntegrate.php" function="bmks_integrate_load_permissions" />
		<hook hook="integrate_remove_topics" file="ADDONSDIR/Bookmarks/BookmarksIntegrate.php" function="bmks_integrate_remove_topics" />
		<hook hook="integrate_display_buttons" file="ADDONSDIR/Bookmarks/BookmarksIntegrate.php" function="bmks_integrate_display_buttons" />
		<hook hook="integrate_menu_buttons" file="ADDONSDIR/Bookmarks/BookmarksIntegrate.php" function="bmks_integrate_menu_buttons" />
		<hook hook="integrate_topic_query" file="ADDONSDIR/Bookmarks/BookmarksIntegrate.php" function="bmks_integrate_topic_query" />
		<hook hook="integrate_display_topic" file="ADDONSDIR/Bookmarks/BookmarksIntegrate.php" function="bmks_integrate_display_topic" />

		<database type="file">install.php</database>
		<redirect url="index.php?action=admin;area=addonsettings;sa=general" timeout="5000">redirect.txt</redirect>
	</install>

	<uninstall for="2.0.0 Beta 1 - 2.0.99">
		<hook reverse="true" hook="integrate_general_mod_settings" file="ADDONSDIR/Bookmarks/BookmarksIntegrate.php" function="bmks_integrate_general_mod_settings" />
		<hook reverse="true" hook="integrate_load_permissions" file="ADDONSDIR/Bookmarks/BookmarksIntegrate.php" function="bmks_integrate_load_permissions" />
		<hook reverse="true" hook="integrate_remove_topics" file="ADDONSDIR/Bookmarks/BookmarksIntegrate.php" function="bmks_integrate_remove_topics" />
		<hook reverse="true" hook="integrate_display_buttons" file="ADDONSDIR/Bookmarks/BookmarksIntegrate.php" function="bmks_integrate_display_buttons" />
		<hook reverse="true" hook="integrate_menu_buttons" file="ADDONSDIR/Bookmarks/BookmarksIntegrate.php" function="bmks_integrate_menu_buttons" />
		<hook reverse="true" hook="integrate_topic_query" file="ADDONSDIR/Bookmarks/BookmarksIntegrate.php" function="bmks_integrate_topic_query" />
		<hook reverse="true" hook="integrate_display_topic" file="ADDONSDIR/Bookmarks/BookmarksIntegrate.php" function="bmks_integrate_display_topic" />

		<remove-dir name="LANGUAGEDIR/Bookmarks" />
		<remove-dir name="ADDONSDIR/Bookmarks" />

		<remove-file name="THEMEDIR/Bookmarks.template.php" />
	</uninstall>

</package-info>
